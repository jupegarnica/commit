{
  "lock": false,
  "tasks": {
    "i:jsr": "deno install --no-config -A -grfn commit  jsr:@garn/commit",
    "i": "deno install --config deno.json -gA -fn commit  commit.ts",
    "i:gpt": "deno install --config deno.json -gA -fn gpt  gpt.ts",
    "dev": "deno run -A commit.ts",
    "gpt": "deno run -A gpt.ts",
    "run": "deno run -A jsr:@garn/commit",
    "publish": "deno publish"
  },
  "name": "@garn/commit",
  "version": "0.0.40",
  "description": "conventional commit generator cli by AI",
  "exports": "./commit.ts",
  "license": "MIT",
  "imports": {
    "@anthropic-ai/sdk": "npm:@anthropic-ai/sdk@0.80.0",
    "@b9g/termdom": "npm:@b9g/termdom@^0.1.6",
    "@david/dax": "jsr:@david/dax@0.42.0",
    "@google/genai": "npm:@google/genai@1.47.0",
    "@std/assert": "jsr:@std/assert@1.0.7",
    "@std/cli": "jsr:@std/cli@1.0.6",
    "@std/fmt": "jsr:@std/fmt@1",
    "ollama": "npm:ollama@0.6.3",
    "openai": "npm:openai@4.38.3"
  }
}
